# 运行环境：production 时 Cookie 强制 Secure
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# 允许跨域并携带 Cookie 的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/movehome
MONGO_DB=movehome

# COS 私有桶（服务端密钥仅用于签发对象级 STS 和校验上传对象）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-chengdu
COS_PREFIX=movehome
# 可选；私有文件预览/下载使用已绑定此桶的自定义源站域名（只填域名，不含 https://）
COS_READ_DOMAIN=assets.convenience.top
# 先验证私有桶 CI 图片处理与费用；通过后才设为 true（默认关闭）
COS_IMAGE_PROCESSING_ENABLED=false
# 可选；若未设置，将从 COS_BUCKET 的末尾 APPID 推导
COS_APP_ID=

# JWT 签名密钥：至少 32 字符的随机串（openssl rand -hex 32）
JWT_SECRET=

# 是否开放注册。首位注册用户始终允许，并自动成为 admin；之后默认关闭
ALLOW_REGISTRATION=false

# 令牌有效期
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
