# 复制为 .env 后填写；切勿提交真实密钥
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
JWT_SECRET=至少 32 个字符的随机字符串
MONGO_URI=mongodb://user:password@127.0.0.1:27017
MONGO_DB=movehome
# 允许访问 API 的前端来源，逗号分隔；发布分享域名后需加入 https://share.convenience.top
CORS_ORIGINS=http://127.0.0.1:5173,https://convenience.top,https://api.convenience.top
ALLOW_REGISTRATION=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# COS 存储（可选；不配置则上传与签名访问不可用）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-chengdu
COS_APP_ID=
COS_PREFIX=movehome
# 已绑定到该私有桶的自定义源站域名，签名读取时使用
COS_READ_DOMAIN=assets.convenience.top
# 数据万象图片处理（缩略图）：需先验证私有桶处理效果与计费后再开启
COS_IMAGE_PROCESSING_ENABLED=false
