# Production: set this to https://api.convenience.top in Makers.
# Leave empty for local Vite development; /api requests go through the local proxy.
VITE_API_BASE_URL=

# By default, local Vite proxies to the live https://api.convenience.top API.
# Valid registration, password changes, and logout will affect live accounts.
# Optional: point to a local Node API instead (allow http://localhost:5173 in its CORS_ORIGINS).
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# VITE_API_PROXY_ORIGIN=http://localhost:5173

# Public Tencent Maps JavaScript key. It is intentionally client-side and must be domain-restricted.
VITE_TENCENT_MAP_KEY=
